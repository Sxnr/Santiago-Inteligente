# Copiar a .env y completar con valores locales - NUNCA subir .env real
# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api
VITE_MAPBOX_TOKEN=pk_example_mapbox_token_aqui

# Backend (Express - Capa Servidor)
PORT=3000
NODE_ENV=development

# Base de datos (Capa Datos - MongoDB NoSQL)
MONGODB_URI=mongodb://localhost:27017/santiago_inteligente
MONGODB_DB_NAME=santiago_inteligente

# Opcional
JWT_SECRET=ejemplo_super_secreto_cambiar_en_local
LOG_LEVEL=info
